# ─── ImaraPay Backend Environment ────────────────────────────────────────────
# Copy this to .env and fill in your real values.
# DO NOT commit .env to source control.

# Django
SECRET_KEY=django-insecure-replace-this-in-production
DEBUG=True
FRONTEND_URL=http://localhost:5173

# ─── Production PostgreSQL Database Configuration ──────────────────────────────
# Use either DATABASE_URL or individual DB_* variables
# DATABASE_URL=postgres://user:password@localhost:5432/imarapay
# DB_NAME=imarapay
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# ─── WhatsApp Cloud API (Meta) ────────────────────────────────────────────────
# Get these from https://developers.facebook.com → your App → WhatsApp → API Setup

# The numeric Phone Number ID (NOT the display phone number)
# e.g. 123456789012345
WHATSAPP_PHONE_NUMBER_ID=

# Permanent system user access token (NOT a temporary user token)
# Must have whatsapp_business_messaging permission
WHATSAPP_ACCESS_TOKEN=

# A secret string YOU choose — must match what you enter in the Meta webhook config
# e.g. imara-pay-webhook-2026
WHATSAPP_VERIFY_TOKEN=imara-dev-verify

# App Secret — found in App Settings → Basic → App Secret
# Used to verify X-Hub-Signature-256 on every inbound webhook
WHATSAPP_APP_SECRET=

# ─── Celery / Redis ───────────────────────────────────────────────────────────
# For local dev without Redis, leave blank — tasks fall back to synchronous
# REDIS_URL=redis://localhost:6379/0

# ─── Payment confirmation threshold (KES minor units = shillings) ─────────────
# Requests >= this value require merchant to tap Confirm in WhatsApp
# Default 1000 = KES 1,000
CONFIRMATION_THRESHOLD_MINOR=1000
